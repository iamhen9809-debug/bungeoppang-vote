rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /votes/{userId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['bite', 'filling'])
        && request.resource.data.keys().hasAll(['bite', 'filling'])
        && request.resource.data.bite in ['head', 'tail', 'body', 'half', 'varies']
        && request.resource.data.filling in ['redbean', 'custard', 'both', 'other'];
      allow update, delete: if false;
    }
  }
}
